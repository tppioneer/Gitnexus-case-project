<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example.telecom</groupId>
    <artifactId>telecom-ops-platform</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Telecom Ops Platform</name>
    <description>Synthetic benchmark project for GitNexus vs grep AI coding comparison</description>

    <modules>
        <module>common-domain</module>
        <module>common-test</module>
        <module>device-collector-service</module>
        <module>device-lifecycle-service</module>
        <module>alarm-engine-service</module>
        <module>alarm-federated-service</module>
        <module>workorder-service</module>
        <module>vendor-collaboration-service</module>
        <module>notification-service</module>
        <module>dispatch-service</module>
        <module>sla-engine-service</module>
        <module>ops-gateway-service</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.example.telecom</groupId>
                <artifactId>common-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
