<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.telecom</groupId>
        <artifactId>telecom-ops-platform</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>network-change-service</artifactId>
    <packaging>jar</packaging>

    <name>Network Change Service</name>
    <description>Network change orchestration service for telecom ops platform.
        Covers router/transmission/radio equipment upgrades, configuration rollout, approval, execution,
        rollback, audit and event notification. Designed as a benchmark fixture for Java/Spring dynamic
        semantics evaluation (Cases H-O).</description>

    <dependencies>
        <!-- Shared domain from common module -->
        <dependency>
            <groupId>com.example.telecom</groupId>
            <artifactId>common-domain</artifactId>
        </dependency>

        <!-- Spring Boot starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
